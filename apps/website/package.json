{
  "name": "@dopejs/deckle-website",
  "version": "0.5.0",
  "private": true,
  "description": "Project website for Deckle with focused, production-facing engine demos.",
  "license": "Apache-2.0",
  "homepage": "https://deckle.dopejs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopejs/deckle.git",
    "directory": "apps/website"
  },
  "bugs": {
    "url": "https://github.com/dopejs/deckle/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-website.mjs",
    "dev": "vite --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dopejs/deckle": "workspace:*",
    "@dopejs/deckle-artifact": "workspace:*",
    "@dopejs/deckle-editor": "workspace:*",
    "@dopejs/deckle-protocol": "workspace:*",
    "@dopejs/deckle-renderer": "workspace:*",
    "@dopejs/deckle-security": "workspace:*",
    "@dopejs/deckle-spatial": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.0",
    "markdown-it-anchor": "9.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
