{
  "name": "@dopejs/canvas-runtime",
  "version": "0.2.0",
  "private": false,
  "description": "Controlled runtime message protocol, epochs, quotas, and capability-guarded host bridge for dope-canvas.",
  "license": "Apache-2.0",
  "homepage": "https://canvas.dopejs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopejs/dope-canvas.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/dopejs/dope-canvas/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@dopejs/canvas-artifact": "workspace:*",
    "@dopejs/canvas-protocol": "workspace:*",
    "@dopejs/canvas-security": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
