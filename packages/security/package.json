{
  "name": "@dopejs/deckle-security",
  "version": "0.4.0",
  "private": false,
  "description": "Sanitization, resource policies, capabilities, and quotas for untrusted Deckle artifacts.",
  "license": "Apache-2.0",
  "homepage": "https://canvas.dopejs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopejs/deckle.git",
    "directory": "packages/security"
  },
  "bugs": {
    "url": "https://github.com/dopejs/deckle/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/prepare-package.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@dopejs/deckle-protocol": "workspace:*"
  }
}
