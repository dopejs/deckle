{
  "name": "@dopejs/canvas-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Internal hit testing, edit-mode selection, hierarchy navigation, and event paths for dope-canvas.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dopejs/canvas-artifact": "workspace:*",
    "@dopejs/canvas-protocol": "workspace:*",
    "@dopejs/canvas-spatial": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
